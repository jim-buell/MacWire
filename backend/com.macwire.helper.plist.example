<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.macwire.helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/MacWire/.venv/bin/python</string>
    <string>-u</string>
    <string>/ABSOLUTE/PATH/TO/MacWire/backend/main.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/LOGS/server.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/LOGS/server-error.log</string>
</dict>
</plist>
