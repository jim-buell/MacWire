# Keep personal configuration and generated content out of source exports.
backend/feeds.json export-ignore
backend/rss_data export-ignore
build export-ignore
client/build export-ignore
dist export-ignore
downloads export-ignore

# Preserve third-party notices verbatim, including upstream whitespace.
backend/licenses/* -whitespace
client/licenses/* -whitespace

# Preserve the author's Markdown hard breaks and spacing verbatim.
README.md whitespace=-blank-at-eol
client/ReadMe.md whitespace=-blank-at-eol
